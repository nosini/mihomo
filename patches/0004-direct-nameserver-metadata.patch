 	// The Windows program behind a Wine connection, beside the process owning its socket
 	WineProcess     string `json:"wineProcess,omitempty"`
 	WineProcessPath string `json:"wineProcessPath,omitempty"`
+
+	// How a direct outbound with its own nameserver list resolved the
+	// destination of this connection, when it did
+	OutboundDNS *OutboundDNS `json:"outboundDns,omitempty"`
+}
+
+// OutboundDNS is set on a connection whose destination was resolved through
+// the direct outbound's own nameservers. The outbound fills it while
+// dialing, before the tracker that exposes the metadata is created, so
+// readers of the connection list cannot race with the write.
+type OutboundDNS struct {
+	Server    string `json:"server,omitempty"`    // nameserver that answered, as configured
+	LocalAddr string `json:"localAddr,omitempty"` // source address of the query, when its transport reports one
+	Interface string `json:"interface,omitempty"` // outbound interface the query was bound to
+	Cached    bool   `json:"cached,omitempty"`    // answered from the outbound's cache
 }
 
