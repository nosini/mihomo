+	// The destination of the connection's packets as they reached mihomo,
+	// before fake-ip, sniffing or rules change DstIP and DstPort. Process
+	// lookup tells apart sockets sharing a source port by it.
+	PacketDst netip.AddrPort `json:"-"`
+
