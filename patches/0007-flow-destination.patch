+// FlowPeers returns the destinations the connection's outgoing packets may
+// have carried when they left their socket: the packet destination, or the
+// inbound's own address when netfilter redirected them to it.
+func (m *Metadata) FlowPeers() []netip.AddrPort {
+	return []netip.AddrPort{m.PacketDst, netip.AddrPortFrom(m.InIP.Unmap(), m.InPort)}
