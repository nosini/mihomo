+// FlowPeers returns the destinations the connection's outgoing packets may
+// have carried when they left their socket: the packet destination for TUN
+// and TPROXY, and the inbound listener's address for proxy, tunnel and REDIR
+// inbounds.
+func (m *Metadata) FlowPeers() []netip.AddrPort {
+	switch m.Type {
+	case TUN, TPROXY:
+		return []netip.AddrPort{m.PacketDst}
+	case INNER:
+		return nil
+	default:
+		return []netip.AddrPort{netip.AddrPortFrom(m.InIP.Unmap(), m.InPort)}
+	}
+}
+
