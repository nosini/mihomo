+// Replace gives key a new sender from maker if it still has old, keeping its
+// local conns, or if it has none. created is false when another sender
+// replaced old first; actual is then that sender.
+func (t *Table) Replace(key string, old C.PacketSender, maker func() C.PacketSender) (actual C.PacketSender, created bool) {
+	item, _ := t.mapping.Compute(key, func(current *entry, loaded bool) (*entry, xsync.ComputeOp) {
+		switch {
+		case !loaded:
+			created = true
+			return &entry{PacketSender: maker(), localConns: &localConns{}}, xsync.UpdateOp
+		case current.PacketSender == old:
+			created = true
+			return &entry{PacketSender: maker(), localConns: current.localConns}, xsync.UpdateOp
+		}
+		return current, xsync.CancelOp
+	})
+	return item.PacketSender, created
+}
+
 func (t *Table) Delete(key string) {
 	t.mapping.Delete(key)
 }
 
+// DeleteFor removes key's entry if it still has sender and passes each of its
+// local conns to f. An entry whose sender was replaced is left to its new
+// sender, local conns included.
+func (t *Table) DeleteFor(key string, sender C.PacketSender, f func(key string, value *net.UDPConn) bool) bool {
+	var removed *entry
+	t.mapping.Compute(key, func(current *entry, loaded bool) (*entry, xsync.ComputeOp) {
+		if loaded && current.PacketSender == sender {
+			removed = current
+			return current, xsync.DeleteOp
+		}
+		return current, xsync.CancelOp
+	})
+	if removed == nil {
+		return false
+	}
+	if f != nil {
+		removed.LocalUDPConnMap.Range(f)
+	}
+	return true
+}
